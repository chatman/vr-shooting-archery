# Generated and captured media stays out of git: output/ alone is ~811 MB of
# photogrammetry meshes, per-view GLBs, renders and video. Everything here is
# reproducible from the tracked source.
output/*
!output/range_10m/
output/range_10m/*
# ...except the deliverables: the hall itself and the Unity/Quest bundle.
!output/range_10m/range_10m.glb
!output/range_10m/unity/
!output/range_10m/unity/**

# Source photographs for the reconstruction pipelines (see README).
bhopal/
kalyani/
lakshya/

# Vendored viewer library.
viewer/lib/

__pycache__/
*.pyc

# Unity project (quest-app/). Library/ alone is ~10 GB and is a rebuildable
# cache: Unity regenerates it on the next open. Everything ignored here is
# derived from Assets/, Packages/ and ProjectSettings/, which are tracked.
quest-app/[Ll]ibrary/
quest-app/[Tt]emp/
quest-app/[Oo]bj/
quest-app/[Bb]uild/
quest-app/[Bb]uilds/
quest-app/[Ll]ogs/
quest-app/[Uu]serSettings/
quest-app/[Mm]emoryCaptures/
quest-app/[Rr]ecordings/
quest-app/.utmp/
quest-app/.vscode/
quest-app/*.csproj
quest-app/*.sln
quest-app/*.unityproj
quest-app/*.user
quest-app/*.apk
quest-app/*.aab
